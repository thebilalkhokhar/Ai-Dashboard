# Copy this file to client/.env.local. The proxy reads these on the server only.

# FastAPI origin the /backend/... proxy forwards to.
BACKEND_API_URL=http://localhost:8000

# One of the backend API_KEYS values, sent as X-API-Key by the proxy.
# Server-side only: it must never be put in a NEXT_PUBLIC_* variable, because
# those are compiled into the browser bundle.
BACKEND_API_KEY=

# Optional: bypass the proxy and let the browser call FastAPI directly.
# Only works when the backend runs with AUTH_ENABLED=false (local development).
# NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
