# Copy this file to server/.env and fill in the values.
# Names and defaults only - never commit a real token or key.

# --- MongoDB ---
MONGO_URI=mongodb://localhost:27017
MONGO_DB=AI

# --- ERP (the client is read-only; drafts are never sent anywhere) ---
ERP_BASE_URL=https://erp.print247.us
ERP_REFRESH_TOKEN=
# How far back ingestion goes, YYYY-MM-DD (default: 12 months ago)
INGEST_FROM=
# Politeness and paging for ERP calls
ERP_REQUEST_DELAY_SECONDS=0.3
ERP_PAGE_LIMIT=500
ERP_LEAD_BATCH_SIZE=25

# --- Redis: locks, shared limits, dashboard caches, live pub/sub ---
REDIS_URL=redis://localhost:6379

# --- API auth ---
# Every /api route needs the X-API-Key header; /health stays open.
# Set AUTH_ENABLED=false for local development only - it logs a loud warning.
AUTH_ENABLED=true
# Comma-separated keys the client may use. The Next.js proxy sends one of these
# from its own BACKEND_API_KEY, so it never appears in browser code.
API_KEYS=cfda43ce9cb2c9ece85eb75ac0b1c82e5c2f1f467b5f8f73
# Comma-separated browser origins allowed by CORS (no trailing slash)
CORS_ORIGINS=http://localhost:3000

# --- LLM (OpenAI stack by default) ---
LLM_PROVIDER=openai
LLM_API_KEY=
# Model for the three sub-agents, and for the Master brief + chat
MODEL_SUB=gpt-5-nano
MODEL_MASTER=gpt-5-nano
# Reasoning effort per role. 'minimal' is cheap but glues words together
# ("todiscuss"), so it stays on the sub-agents; Master and chat use 'low'.
SUB_AGENT_REASONING_EFFORT=minimal
MASTER_REASONING_EFFORT=low
CHAT_REASONING_EFFORT=low

# --- Business rules, in days ---
# A quote is stale after this many days...
STALE_QUOTE_DAYS=3
# ...and older than this is dead history, not an opportunity
STALE_QUOTE_MAX_AGE_DAYS=30
# Stalled-order threshold (signal is unreliable: the ERP has no status timestamps)
STALLED_ORDER_DAYS=2
# An invoice counts as overdue after this many days
OVERDUE_INVOICE_DAYS=30
# A lead is "stuck" when its last activity is within this window
LEAD_ACTIVE_DAYS=14

# --- Agents ---
# Items each sub-agent processes per run, and how many LLM calls may run at once
MAX_ITEMS_PER_AGENT=10
AGENT_CONCURRENCY=5
# Reuse an identical input hash for this many hours instead of paying again
AGENT_CACHE_HOURS=24
# One run at a time: TTL of the Redis lock and of the 'running' document
AGENT_RUN_LOCK_TTL_SECONDS=1800

# --- Chat limits ---
# Daily token budget for the chat agent
CHAT_DAILY_TOKEN_CAP=1000000
# Sliding-window rate limit, kept in Redis so every worker shares it
CHAT_RATE_LIMIT_REQUESTS=30
CHAT_RATE_LIMIT_WINDOW_SECONDS=60

# --- Live dashboard (SSE) ---
# Concurrent streams, counted in Redis; a slot a dead worker left behind
# expires after LIVE_CLIENT_SLOT_TTL_SECONDS
LIVE_MAX_CLIENTS=20
LIVE_CLIENT_SLOT_TTL_SECONDS=3600

# --- /api/signals ---
# Rows per list in the report; the summary counts always cover every row and
# the whole report is cached in Redis and refreshed by the scheduler.
SIGNALS_ITEM_LIMIT=200

# --- Scheduler (in-process asyncio tasks) ---
SCHEDULER_ENABLED=true
# Refresh cycle in minutes; only this many recent days are re-pulled per cycle
REFRESH_MINUTES=5
REFRESH_LOOKBACK_DAYS=2
# Daily full agent run, server-local hour (0-23)
AGENT_FULL_RUN_HOUR=6
# Leader election TTL: one worker runs the schedule, a standby takes over
# within this long if the leader dies
SCHEDULER_LEADER_TTL_SECONDS=60

# --- Customer 360 (Zoho-synced CRM backend; read endpoints only) ---
# Login is a real user's email + password traded for a 7-day JWT; there is
# no API key. Use a dedicated integration user where possible. The write
# endpoints (trigger-call, save-draft) are never called by this app.
C360_BASE_URL=https://zoho-ai-backend.vercel.app/api
C360_EMAIL=
C360_PASSWORD=
C360_TIMEOUT_SECONDS=120
C360_CACHE_MINUTES=30
# The server re-syncs the CRM mirror by itself: a full sync when the
# last one is older than C360_SYNC_HOURS, and a cheap first-pages pass
# every C360_RECENT_SYNC_MINUTES in between (new records are at the top
# of the CRM's lists). run_c360_sync.py stays for an immediate refresh.
C360_SYNC_ENABLED=true
C360_SYNC_HOURS=6
C360_RECENT_SYNC_MINUTES=15
C360_RECENT_PAGES=3
