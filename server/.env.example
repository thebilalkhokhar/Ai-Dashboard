# Copy this file to server/.env and fill in the values.
# Names only, never commit real values.

# --- MongoDB ---
MONGO_URI=mongodb://localhost:27017
MONGO_DB=AI

# --- ERP (read-only) ---
ERP_REFRESH_TOKEN=

# --- LLM (OpenAI stack by default) ---
LLM_PROVIDER=openai
LLM_API_KEY=
MODEL_SUB=gpt-5-nano
MODEL_MASTER=gpt-5-nano
# Reasoning effort per role. 'minimal' is cheap but glues words together, so it
# is only safe for the sub-agents; the Master brief and chat use 'low'.
SUB_AGENT_REASONING_EFFORT=minimal
MASTER_REASONING_EFFORT=low
CHAT_REASONING_EFFORT=low

# --- Business rules (days) ---
STALE_QUOTE_DAYS=3
STALE_QUOTE_MAX_AGE_DAYS=30
STALLED_ORDER_DAYS=2
OVERDUE_INVOICE_DAYS=30
LEAD_ACTIVE_DAYS=14

# --- Agents / scheduler ---
MAX_ITEMS_PER_AGENT=10
AGENT_CACHE_HOURS=24
AGENT_CONCURRENCY=5
CHAT_DAILY_TOKEN_CAP=1000000
SCHEDULER_ENABLED=true

# --- API auth ---
# Every /api route needs the X-API-Key header; /health stays open.
# Set this to false for local development only - the API logs a loud warning.
AUTH_ENABLED=true
# Comma-separated keys the client may use. The Next.js proxy sends one of these
# from its own BACKEND_API_KEY, so it never appears in browser code.
API_KEYS=change-me-then-rotate

# Browser origins allowed to call the API (comma-separated, no trailing slash).
CORS_ORIGINS=http://localhost:3000

# --- One agent run at a time ---
# TTL (seconds) of the Redis run lock; also how long a 'running' document in
# agent_runs is trusted before a new run may start.
AGENT_RUN_LOCK_TTL_SECONDS=1800

# --- Limits kept in Redis (shared by every worker) ---
# POST /api/chat: this many requests per sliding window.
CHAT_RATE_LIMIT_REQUESTS=30
CHAT_RATE_LIMIT_WINDOW_SECONDS=60
# GET /api/live: SSE slots expire on their own after this many seconds, so a
# worker that dies cannot hold LIVE_MAX_CLIENTS forever.
LIVE_CLIENT_SLOT_TTL_SECONDS=3600
# Only one scheduler runs the refresh cycle across workers: Redis leader
# election, renewed every third of this TTL; a standby takes over after it.
SCHEDULER_LEADER_TTL_SECONDS=60

# --- /api/signals ---
# Maximum rows per list in the report. Summary counts still cover every row,
# and the report itself is cached in Redis and refreshed by the scheduler.
SIGNALS_ITEM_LIMIT=200
